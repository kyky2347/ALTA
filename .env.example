# Inject credentials through the environment or keep optional RTF files under
# ~/.config/alta/credentials/llm/. Never store credentials inside the project tree.
# ALTA_CREDENTIALS_DIR may point to a different absolute external root.
ALTA_CREDENTIALS_DIR=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=

# Share the local official Codex login by default while ALTA keeps config,
# sessions, caches, and binaries isolated. Set isolated for a separate login.
ALTA_OPENAI_AUTH_MODE=official

# Optional first-run overrides for `./alta env setup`. Python 3.12 is managed
# under .alta by uv; PostgreSQL/Redis passwords are generated into ignored
# mode-0600 secret files and must never be placed here.
ALTA_POSTGRES_PORT=55432
ALTA_REDIS_PORT=56379
ALTA_POSTGRES_MEMORY=1g
ALTA_POSTGRES_CPUS=2
ALTA_REDIS_MAXMEMORY=512mb
ALTA_REDIS_MEMORY=768m
ALTA_REDIS_CPUS=1

# Optional proxy for networks where a provider is intermittently unreachable.
# ALTA maps this to Node's HTTPS proxy support before the local gateway starts.
ALTA_HTTPS_PROXY=

# Reliability tuning (defaults shown).
ALTA_MAX_RETRIES=12
ALTA_RETRY_BUDGET_MS=300000
ALTA_HEARTBEAT_MS=10000
ALTA_REQUEST_TIMEOUT_MS=600000
# auto pauses ChatGPT-only Apps/plugin sync/analytics for third-party roots when
# the isolated access token is expired. Use 1 or 0 to force either behavior.
ALTA_THIRD_PARTY_OPENAI_SERVICES=auto

# Opportunity OS autonomous Shadow runtime. API keys remain outside source and
# must be injected by the service process or an external secret helper.
ALTA_ENVIRONMENT=replay
ALTA_AUTONOMOUS_ENABLED=0
ALTA_SERVICE_HOST=127.0.0.1
ALTA_SERVICE_PORT=8876
ALTA_AUTONOMOUS_INTERVAL_SECONDS=1800
ALTA_AUTONOMOUS_FOLLOW_UP_INTERVAL_SECONDS=900
ALTA_AUTONOMOUS_POSITION_INTERVAL_SECONDS=300
ALTA_AUTONOMOUS_HEARTBEAT_SECONDS=30
ALTA_AUTONOMOUS_FAILURE_BACKOFF_SECONDS=60
ALTA_AUTONOMOUS_FAILURE_BACKOFF_MAX_SECONDS=1800
ALTA_AUTONOMOUS_CYCLE_TIMEOUT_SECONDS=3600
ALTA_EVALUATION_COHORT_ID=exploratory-v1
ALTA_EVALUATION_MIN_CLOSED_POSITIONS=30
# The built-in service supervisor recovers indefinitely unless an explicit
# --max-restarts test limit is passed. Readiness failure triggers its watchdog.
ALTA_SUPERVISOR_RESTART_MAX_SECONDS=300
ALTA_SUPERVISOR_STABLE_UPTIME_SECONDS=600
ALTA_SUPERVISOR_PROBE_SECONDS=5
ALTA_SUPERVISOR_UNHEALTHY_GRACE_SECONDS=120
# Loss of liveness is different from a temporary dependency/readiness failure:
# the child process group is replaced quickly, including stuck Agent children.
ALTA_SUPERVISOR_UNRESPONSIVE_GRACE_SECONDS=15
ALTA_SUPERVISOR_SHUTDOWN_GRACE_SECONDS=30
# The host service truncates its active stdout/stderr logs at this size. Durable
# Agent, opportunity, expression, and position records remain in PostgreSQL.
ALTA_SERVICE_LOG_MAX_MB=16
ALTA_AGENT_PROVIDER=deepseek
ALTA_AGENT_MODEL=deepseek-v4-flash
ALTA_AGENT_REASONING_EFFORT=high
# Judgment roles use independent model families by default. The two private
# assessors and the expression/audit pair must not resolve to the same route.
ALTA_THESIS_PROVIDER=deepseek
ALTA_THESIS_MODEL=deepseek-v4-pro
ALTA_DISCONFIRMING_PROVIDER=grok
ALTA_DISCONFIRMING_MODEL=grok-4.6
ALTA_MODERATOR_PROVIDER=kimi
ALTA_MODERATOR_MODEL=kimi-k3
ALTA_EXPRESSION_PROVIDER=deepseek
ALTA_EXPRESSION_MODEL=deepseek-v4-pro
ALTA_AUDIT_PROVIDER=grok
ALTA_AUDIT_MODEL=grok-4.6
ALTA_AGENT_DEADLINE_SECONDS=180
# Slower, higher-judgment PM, debate, expression, and audit roles get a
# separate bound so a transient long inference cannot silently discard a thesis.
ALTA_REASONING_AGENT_DEADLINE_SECONDS=300
# Four isolated App Server minds let the four orthogonal Scouts run in parallel.
ALTA_SCOUT_CONCURRENCY=4
ALTA_MASSIVE_ENABLED=1
ALTA_MASSIVE_DISCOVERY_ENABLED=0
ALTA_MASSIVE_MAX_REQUESTS_PER_CYCLE=8
ALTA_MASSIVE_BASE_URL=https://api.massive.com
ALTA_MASSIVE_ALLOW_INSECURE_HTTP=0
ALTA_MASSIVE_AUTH_MODE=bearer
MASSIVE_API_KEY=
FINLIGHT_API_KEY=
ALTA_SHADOW_MAX_POSITION_NOTIONAL=10000
# Research capital policy. NAV is a synthetic Shadow reference, never a broker
# balance. Every entry must pass loss, position, gross, cost, and exit-capacity
# gates; missing liquidity or independent underwriting produces Wait.
ALTA_SHADOW_REFERENCE_NAV=1000000
ALTA_SHADOW_TRADE_LOSS_BUDGET_BPS=25
ALTA_SHADOW_MAX_POSITION_NAV_BPS=100
ALTA_SHADOW_MAX_GROSS_NAV_BPS=800
ALTA_SHADOW_EQUITY_STRESS_FLOOR_BPS=2500
ALTA_SHADOW_MAX_EXIT_DAYS=2
ALTA_SHADOW_ADV_PARTICIPATION_BPS=500
ALTA_SHADOW_MIN_NET_ALPHA_BPS=50

# Tiger is disabled by default. When explicitly enabled, only one exact
# 17-digit Paper account, one-share DAY limit orders, and an acceptance hold are
# admitted. Store the config and account hash outside the project tree; never
# use a live ID. ~/.config/alta/credentials/resources/ is the recommended local
# boundary.
ALTA_TIGER_PAPER_ENABLED=0
ALTA_TIGER_CONFIG_PATH=
ALTA_TIGER_PAPER_ACCOUNT_SHA256=
ALTA_TIGER_ORDER_TIMEOUT_SECONDS=20
ALTA_ACCEPTANCE_HOLD_SECONDS=

# Portable internet layer. Existing xAI credentials provide the default live
# search backend. Brave or a SearXNG endpoint can be selected automatically
# when configured; keys stay in the loopback gateway and never reach agents.
BRAVE_SEARCH_API_KEY=
ALTA_SEARXNG_URL=
ALTA_WEB_XAI_MODEL=
# Set to 0 when Opportunity Agents must not use an auxiliary xAI search model;
# direct public-source and DuckDuckGo/Bing fallback tools remain available.
ALTA_XAI_WEB_SEARCH_ENABLED=0
# Optional: higher Jina Reader/Search rate limits. The key stays inside the
# loopback gateway and is removed from agents.
JINA_API_KEY=
# Optional scholarly-discovery identity. OpenAlex remains a partial-failure
# source without a key; Crossref uses mailto to route requests politely.
OPENALEX_API_KEY=
CROSSREF_MAILTO=
# Optional public federated instances and SEC identity. These are not login
# credentials. SEC asks automated clients to identify themselves.
ALTA_LEMMY_URL=https://lemmy.world
ALTA_MASTODON_URL=https://mastodon.social
ALTA_PEERTUBE_URL=https://peertube.tv
ALTA_DISCOURSE_URL=https://meta.discourse.org
ALTA_SEC_USER_AGENT=Autonomous LLM Trading Asterism/3.5 research-operator@example.com
ALTA_WEB_READER_ENABLED=1
ALTA_WEB_READER_URL=https://r.jina.ai
ALTA_WEB_READER_MIN_CHARS=500
ALTA_WEB_CONCURRENCY=6
ALTA_WEB_CRAWL_CONCURRENCY=3
ALTA_WEB_BACKEND_FAILURES=2
ALTA_WEB_BACKEND_COOLDOWN_MS=15000
ALTA_WEB_INFLIGHT_LIMIT=256
ALTA_WEB_QUEUE_LIMIT=128
ALTA_WEB_TIMEOUT_MS=45000
ALTA_WEB_MAX_DOWNLOAD_MB=4
ALTA_WEB_MAX_OUTPUT_CHARS=32000
ALTA_WEB_CACHE_MB=32
ALTA_WEB_CACHE_TTL_MINUTES=10
ALTA_WEB_STALE_TTL_MINUTES=60
# Mainland proxy/TUN clients often synthesize 198.18.0.0/15 DNS answers.
# Keep enabled for those clients; set 0 when that compatibility is unnecessary.
ALTA_ALLOW_PROXY_FAKE_IP=1

# 24x7 multi-agent admission control and memory bounds.
ALTA_AGENT_THREADS=4
ALTA_MAX_CONCURRENT_REQUESTS=16
ALTA_MAX_QUEUED_REQUESTS=256
ALTA_QUEUE_TIMEOUT_MS=120000
ALTA_DEEPSEEK_CONCURRENCY=8
ALTA_XAI_CONCURRENCY=8
ALTA_KIMI_CONCURRENCY=8
ALTA_MAX_REQUEST_MB=16
ALTA_MAX_RESPONSE_MB=32
ALTA_REQUEST_MEMORY_MB=128
ALTA_MAX_RSS_MB=2048
# Media uses a separate low-concurrency lane so large inputs cannot starve text.
ALTA_MULTIMODAL_CONCURRENCY=2
ALTA_MAX_MULTIMODAL_MB=8
ALTA_MAX_MEDIA_ITEMS=16
ALTA_MAX_MEDIA_TOKENS=9000
ALTA_MAX_TEXT_FILE_PREVIEW_BYTES=900
ALTA_SHUTDOWN_GRACE_MS=30000

# Storage guard. Cold Codex rollouts are compressed natively after seven days;
# ALTA bounds history/cache files and keeps this amount of disk free.
ALTA_HISTORY_MAX_MB=64
ALTA_STORAGE_MAX_GB=20
ALTA_STORAGE_RESERVE_GB=5
ALTA_BUILD_MIN_FREE_GB=15
ALTA_CACHE_MAX_GB=2
ALTA_CACHE_TTL_DAYS=7
ALTA_TEMP_TTL_HOURS=24
ALTA_LOG_TTL_DAYS=14
ALTA_MAINTENANCE_INTERVAL_MS=300000
ALTA_STORAGE_ADMISSION_CACHE_MS=1000
ALTA_STORAGE_IO_CONCURRENCY=16

# 0 copies the release binary to .alta/bin and discards Cargo target, registry,
# and dependency caches. Set to 1 only if rebuild speed matters more.
ALTA_KEEP_BUILD_CACHE=0

# Foreground supervisor crash-loop control.
ALTA_RESTART_BASE_MS=1000
ALTA_RESTART_MAX_MS=300000
ALTA_STABLE_UPTIME_MS=600000
ALTA_RESTARTS_PER_HOUR=20
ALTA_RESTART_ON_SUCCESS=0
